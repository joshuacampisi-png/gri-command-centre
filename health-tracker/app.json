      "bundleIdentifier": "com.vitals.healthtracker"
    },
    "android": {
      "package": "com.vitals.healthtracker",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
