{
  "name": "vitals-health-pwa",
  "version": "1.0.0",
  "description": "Installable PWA — live Oura Ring data + historic blood tests, with insights.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node server.js",
    "build": "vite build",
    "start": "node server.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
