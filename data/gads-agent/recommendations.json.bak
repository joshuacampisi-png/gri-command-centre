      "convRate": 0.058823529411764705
    },
    "proposedChange": {
      "action": "INCREASE_BID",
      "criterionId": "593722840075",
      "adGroupId": "165478691408",
      "multiplier": 1.25
    },
    "bestPracticeSource": "https://support.google.com/google-ads/answer/2472725?hl=en",
    "bestPracticeSummary": "For profitable keywords converting below breakeven like 'gender powder cannon' at $33.14 CPP vs $49.35 breakeven, implement Target ROAS bidding strategy to increase bids automatically when Google AI identifies profitable conversion opportunities. Google recommends switching from manual or Target CPA to value-based Target ROAS bidding, which drives 14% more conversion value at similar return on ad spend according to 2025 guidance.",
