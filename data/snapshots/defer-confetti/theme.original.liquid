<script>
(function() {
  console.log('[CornerAutoCheck] Script loaded');
  
  const OPT_OUT_KEY = 'gri_corner_upsell_opted_out';
  
  // Check if user has already opted out this session
  function hasOptedOut() {
    try {
      return sessionStorage.getItem(OPT_OUT_KEY) === '1';
    } catch (e) {
      return false;
    }
  }
  
  function setOptedOut() {
    try {
      sessionStorage.setItem(OPT_OUT_KEY, '1');
      console.log('[CornerAutoCheck] Opt-out saved for this session');
    } catch (e) {}
  }

  function findCheckbox() {
    return document.querySelector('input[id^="corner-cowi-checkbox-input-corner-upsell-"]')
        || document.querySelector('corner-check-box input[type="checkbox"]')
        || document.querySelector('.corner-cowi-cart-one-click-checkbox input[type="checkbox"]');
  }

  function autoCheckCornerUpsell() {
    // If user opted out this session, never auto-check
    if (hasOptedOut()) return;
    
    const checkbox = findCheckbox();
    if (!checkbox) return;
    if (checkbox.checked) return;

    const label = checkbox.closest('label')
      || document.querySelector(`label[for="${checkbox.id}"]`);

    if (label) {
      label.click();
    } else {
      checkbox.click();
    }
  }

  // Listen for manual untick — save opt-out so we don't fight the user
  document.addEventListener('change', function(e) {
    const t = e.target;
    if (t && t.id && t.id.startsWith('corner-cowi-checkbox-input-corner-upsell-')) {
      if (!t.checked) {
        setOptedOut();
      }
    }
  }, true);

  // Also catch clicks on the label (Corner may not fire 'change' depending on impl)
  document.addEventListener('click', function(e) {
    const label = e.target.closest('label.corner-cowi-checkbox-corner-upsell-27932, label[class*="corner-cowi-checkbox-corner-upsell"]');
    if (!label) return;
    
    // Wait a tick for Corner's handler to flip the state, then check
    setTimeout(() => {
      const cb = findCheckbox();
      if (cb && !cb.checked) {
        setOptedOut();
      }
    }, 100);
  }, true);

  const observer = new MutationObserver(autoCheckCornerUpsell);

  function start() {
    observer.observe(document.body, { childList: true, subtree: true });
    autoCheckCornerUpsell();

    let retries = 0;
    const interval = setInterval(() => {
      autoCheckCornerUpsell();
      if (++retries >= 10) clearInterval(interval);
    }, 500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }

  document.addEventListener('click', function(e) {
    if (e.target.closest('a[href="/cart"], cart-drawer summary, [aria-controls*="cart"]')) {
      setTimeout(autoCheckCornerUpsell, 400);
      setTimeout(autoCheckCornerUpsell, 1000);
    }
  });
})();
</script>

