<script>
  function confetti() {
    var confettiElements = document.querySelectorAll('.confetti-particles');
    var confettiCount = confettiElements.length;

    confettiElements.forEach(function (element) {
      let inc = 1;
      element.style.animationDelay = 2 + inc + 's';
      var confetticount = (element.offsetWidth / 50) * 10;
      for (var i = 0; i <= confetticount; i++) {
        var span = document.createElement('span');
        span.className = 'particle c' + getRandomInt(1, 2);
        span.style.top = getRandomInt(-1, -2) + '%';
        span.style.left = getRandomInt(0, 100) + '%';
        span.style.width = getRandomInt(6, 8) + 'px';
        span.style.height = getRandomInt(3, 4) + 'px';
        span.style.animationDelay = getRandomInt(0, 30) / 10 + 's';
        element.appendChild(span);
      }

      inc = inc + 1;
    });
  }

  function getRandomInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  confetti();
</script>

