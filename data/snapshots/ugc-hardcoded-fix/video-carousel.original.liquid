<script>
(function(){
  var s = document.createElement('style');
  s.textContent = '[id*="__ugc_video"]{display:none!important;height:0!important;padding:0!important;margin:0!important}'
;
  document.head.appendChild(s);
  var el = document.querySelector('[id*="__ugc_video"]');
  if (el) { el.style.display = 'none'; el.style.height = '0'; el.style.overflow = 'hidden'; }
})();
</script>

<style>

  #ugc-{{ section.id }} {
    --gri-teal: #3AB4C0;
    --gri-teal-dark: #2a9d96;
    --gri-pink: #E43F7B;
    --gri-pink-dark: #d63384;
    --gri-pink-light: #fce4f0;
    --gri-blue-light: #e0f4f3;
    --ugc-bg: #FAF8F5;
    --ugc-text: #1A1A1A;
    --ugc-text-mid: #555;
    --ugc-text-light: #888;
    --ugc-radius: 24px;
    --ugc-radius-md: 12px;
    --ugc-radius-sm: 8px;
    --ugc-ease: cubic-bezier(0.16, 1, 0.3, 1);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
    background: var(--ugc-bg);
  }
  #ugc-{{ section.id }} * { box-sizing: border-box; }

  #ugc-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: -160px; left: -10%; width: 120%; height: 500px;
    background: radial-gradient(ellipse at 30% 0%, var(--gri-pink-light) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 0%, var(--gri-blue-light) 0%, transparent 60%);
    opacity: 0.5; z-index: 0; pointer-events: none;
  }

  .ugc-hdr-{{ section.id }} {
    text-align: center; max-width: 680px; margin: 0 auto 36px;
    padding: 0 24px; position: relative; z-index: 1;
  }
  .ugc-h2-{{ section.id }} { text-align: center; display: block; width: 100%; }
  .ugc-badge-{{ section.id }} {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--gri-pink);
    color: white; font-size: 11px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    padding: 6px 16px; border-radius: 50px; margin-bottom: 16px;
    box-shadow: 0 2px 8px rgba(232, 67, 147, 0.18);
  }
  .ugc-badge-{{ section.id }} svg { width: 14px; height: 14px; fill: white; }
  .ugc-h2-{{ section.id }} {
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 900; line-height: 1.08;
    letter-spacing: -0.03em; margin: 0 0 12px; color: var(--ugc-text);
  }
  .ugc-h2-{{ section.id }} span {
    color: var(--gri-pink);
  }
  .ugc-sub-{{ section.id }} { font-size: 15px; color: var(--ugc-text-mid); line-height: 1.5; margin: 0; }

  .ugc-scroll-{{ section.id }} {
    display: flex; gap: 18px;
    padding: 4px max(20px, calc((100vw - 1300px) / 2)) 4px;
    overflow-x: auto; scroll-snap-type: x proximity; scroll-padding: 20px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; position: relative; z-index: 1;
  }
  .ugc-scroll-{{ section.id }}::-webkit-scrollbar { display: none; }

  .ugc-card-{{ section.id }} {
    flex: 0 0 260px; scroll-snap-align: center;
    border-radius: var(--ugc-radius); overflow: hidden;
    position: relative; background: #111;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  }
  @media (hover: hover) {
    .ugc-card-{{ section.id }} {
      transition: transform 0.5s var(--ugc-ease), box-shadow 0.5s var(--ugc-ease);
    }
    .ugc-card-{{ section.id }}:hover {
      transform: translateY(-6px) scale(1.02);
      box-shadow: 0 16px 48px rgba(0,0,0,0.12);
    }
  }

  .ugc-vid-{{ section.id }} {
    position: relative; aspect-ratio: 9 / 14; overflow: hidden; background: #0a0a0a;
  }
  .ugc-vid-{{ section.id }} video {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  .ugc-play-{{ section.id }} {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 52px; height: 52px;
    background: rgba(255,255,255,0.18); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    border: 2px solid rgba(255,255,255,0.25); z-index: 5;
    transition: opacity 0.3s ease; pointer-events: none;
  }
  .ugc-play-{{ section.id }}.hide { opacity: 0; }
  .ugc-play-{{ section.id }} svg { width: 20px; height: 20px; fill: white; margin-left: 3px; }

  .ugc-ig-{{ section.id }} {
    position: absolute; top: 12px; right: 12px; z-index: 6;
    width: 30px; height: 30px; border-radius: 8px;
    background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }
  .ugc-ig-{{ section.id }} svg { width: 16px; height: 16px; fill: white; }

  .ugc-vol-{{ section.id }} {
    position: absolute; top: 12px; left: 12px; z-index: 8;
    width: 30px; height: 30px; border-radius: 50%;
    background: rgba(0,0,0,0.45); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    border: none; cursor: pointer; padding: 0;
    -webkit-tap-highlight-color: transparent;
  }
  .ugc-vol-{{ section.id }} svg { width: 16px; height: 16px; fill: white; }
  .ugc-vol-{{ section.id }} .ugc-vol-on { display: none; }
  .ugc-vol-{{ section.id }}.is-unmuted .ugc-vol-off { display: none; }
  .ugc-vol-{{ section.id }}.is-unmuted .ugc-vol-on { display: block; }

  .ugc-acts-{{ section.id }} {
    position: absolute; right: 10px; bottom: 110px;
    display: flex; flex-direction: column; gap: 14px; z-index: 8;
  }
  .ugc-abtn-{{ section.id }} {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    background: none; border: none; cursor: pointer; padding: 4px;
    -webkit-tap-highlight-color: transparent;
  }
  .ugc-abtn-{{ section.id }} svg {
    width: 26px; height: 26px; fill: white;
    filter: drop-shadow(0 1px 3px rgba(0,0,0,0.4));
    transition: all 0.25s var(--ugc-ease);
  }
  .ugc-abtn-{{ section.id }} span {
    font-size: 11px; color: white; font-weight: 600;
    text-shadow: 0 1px 2px rgba(0,0,0,0.5);
  }
  .ugc-abtn-{{ section.id }}.is-liked svg {
    fill: #FF3040;
    filter: drop-shadow(0 0 8px rgba(255,48,64,0.5));
    animation: ugcPop{{ section.id }} 0.4s var(--ugc-ease);
  }
  @keyframes ugcPop{{ section.id }} {
    0%{transform:scale(1)}25%{transform:scale(1.4)}50%{transform:scale(0.9)}100%{transform:scale(1)}
  }

  .ugc-prod-{{ section.id }} {
    position: absolute; bottom: 10px; left: 10px; right: 10px;
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-radius: var(--ugc-radius-md);
    padding: 8px 10px; display: flex; align-items: center; gap: 10px;
    z-index: 6; box-shadow: 0 8px 32px rgba(0,0,0,0.15);
    text-decoration: none; color: inherit;
  }
  .ugc-prod-{{ section.id }} img {
    width: 48px; height: 48px; border-radius: var(--ugc-radius-sm);
    object-fit: contain; background: #f5f5f5; flex-shrink: 0;
  }
  .ugc-pinfo-{{ section.id }} { flex: 1; min-width: 0; overflow: hidden; }
  .ugc-pname-{{ section.id }} {
    font-size: 11px; font-weight: 700; color: var(--ugc-text);
    line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .ugc-pprice-{{ section.id }} { display: flex; align-items: center; gap: 4px; margin-top: 2px; }
  .ugc-pprice-{{ section.id }} .ugc-now { font-size: 13px; font-weight: 800; color: var(--gri-pink); }
  .ugc-pprice-{{ section.id }} .ugc-was { font-size: 10px; color: var(--ugc-text-light); text-decoration: line-through; }

  .ugc-atc-{{ section.id }} {
    flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; border: none;
    background: linear-gradient(135deg, var(--gri-pink), var(--gri-pink-dark));
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: all 0.3s var(--ugc-ease); position: relative; overflow: hidden;
  }
  .ugc-atc-{{ section.id }}:hover { transform: scale(1.1); box-shadow: 0 4px 16px rgba(232,67,147,0.4); }
  .ugc-atc-{{ section.id }}:active { transform: scale(0.92); }
  .ugc-atc-{{ section.id }} svg { width: 18px; height: 18px; fill: white; transition: transform 0.3s var(--ugc-ease); }
  .ugc-atc-{{ section.id }} .ugc-chk { position: absolute; transform: scale(0) rotate(-180deg); transition: transform 0.3s var(--ugc-ease); }
  .ugc-atc-{{ section.id }}.is-added svg:first-child { transform: scale(0) rotate(180deg); }
  .ugc-atc-{{ section.id }}.is-added .ugc-chk { transform: scale(1) rotate(0); }
  .ugc-atc-{{ section.id }}.is-added { background: linear-gradient(135deg, var(--gri-teal), var(--gri-teal-dark)); }

  .ugc-nav-{{ section.id }} {
    display: flex; justify-content: center; align-items: center; gap: 10px;
    margin-top: 20px; padding: 0 24px; position: relative; z-index: 1;
  }
  .ugc-nbtn-{{ section.id }} {
    width: 36px; height: 36px; border-radius: 50%;
    border: 2px solid rgba(26,26,26,0.1); background: white;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: all 0.3s var(--ugc-ease);
  }
  .ugc-nbtn-{{ section.id }} svg { width: 16px; height: 16px; }
  .ugc-nbtn-{{ section.id }}:hover { border-color: var(--gri-pink); background: var(--gri-pink-light); }
  .ugc-nbtn-{{ section.id }} svg { width: 18px; height: 18px; fill: var(--ugc-text); }
  .ugc-dots-{{ section.id }} { display: flex; gap: 5px; align-items: center; }
  .ugc-dot-{{ section.id }} {
    width: 7px; height: 7px; border-radius: 50%;
    background: rgba(26,26,26,0.12); transition: all 0.3s var(--ugc-ease);
  }
  .ugc-dot-{{ section.id }}.on {
    width: 22px; border-radius: 50px;
    background: linear-gradient(135deg, var(--gri-pink), var(--gri-teal));
  }

  .ugc-cta-{{ section.id }} {
    max-width: 560px; margin: 16px auto 0; padding: 0 24px;
    text-align: center; position: relative; z-index: 1;
  }
  .ugc-cta-{{ section.id }} p { font-size: 13px; color: var(--ugc-text-mid); margin: 0 0 10px; }
  .ugc-cta-{{ section.id }} strong { color: var(--gri-pink); }
  .ugc-ctab-{{ section.id }} {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 24px; border: 2px solid var(--gri-teal);
    background: transparent; color: var(--gri-teal-dark);
    font: inherit; font-size: 13px; font-weight: 700;
    border-radius: 50px; cursor: pointer; transition: all 0.3s var(--ugc-ease);
    text-decoration: none;
  }
  .ugc-ctab-{{ section.id }}:hover {
    background: var(--gri-teal); color: white;
    transform: translateY(-2px); box-shadow: 0 8px 24px rgba(60,188,180,0.3);
  }
  .ugc-ctab-{{ section.id }} svg { width: 16px; height: 16px; fill: currentColor; }

  /* Colour picker popup */
  .ugc-picker-overlay-{{ section.id }} {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.5); z-index: 99998;
    opacity: 0; pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .ugc-picker-overlay-{{ section.id }}.on { opacity: 1; pointer-events: auto; }

  .ugc-picker-{{ section.id }} {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: white; border-radius: 20px 20px 0 0;
    padding: 24px 20px calc(24px + env(safe-area-inset-bottom, 0px));
    z-index: 99999;
    transform: translateY(100%);
    transition: transform 0.35s var(--ugc-ease);
    box-shadow: 0 -8px 40px rgba(0,0,0,0.15);
    max-width: 500px; margin: 0 auto;
  }
  .ugc-picker-{{ section.id }}.on { transform: translateY(0); }

  .ugc-picker-{{ section.id }} .pk-header {
    display: flex; align-items: center; gap: 12px; margin-bottom: 20px;
  }
  .ugc-picker-{{ section.id }} .pk-img {
    width: 56px; height: 56px; border-radius: 12px;
    object-fit: contain; background: #f5f5f5;
  }
  .ugc-picker-{{ section.id }} .pk-info { flex: 1; min-width: 0; }
  .ugc-picker-{{ section.id }} .pk-name {
    font-size: 14px; font-weight: 700; color: var(--ugc-text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .ugc-picker-{{ section.id }} .pk-price {
    font-size: 16px; font-weight: 800; color: var(--gri-pink); margin-top: 2px;
  }
  .ugc-picker-{{ section.id }} .pk-close {
    width: 32px; height: 32px; border-radius: 50%;
    background: #f0f0f0; border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .ugc-picker-{{ section.id }} .pk-close svg { width: 16px; height: 16px; fill: #666; }

  .ugc-picker-{{ section.id }} .pk-label {
    font-size: 12px; font-weight: 700; color: var(--ugc-text-mid);
    text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 10px;
  }
  .ugc-picker-{{ section.id }} .pk-options {
    display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px;
  }
  .ugc-picker-{{ section.id }} .pk-opt {
    padding: 10px 20px; border-radius: 8px; border: 2px solid #e0e0e0;
    background: white; font: inherit; font-size: 14px; font-weight: 600;
    color: var(--ugc-text); cursor: pointer; transition: all 0.2s ease;
  }
  .ugc-picker-{{ section.id }} .pk-opt:hover { border-color: #000; }
  .ugc-picker-{{ section.id }} .pk-opt.on {
    border-color: #000; background: #000; color: #fff;
  }
  .ugc-picker-{{ section.id }} .pk-atc {
    width: 100%; padding: 14px 22px; border: none; border-radius: 8px;
    background: #000; color: #fff;
    font-family: 'bolota', sans-serif; font-size: 16px; font-weight: 700;
    cursor: pointer; transition: opacity 0.2s ease;
    margin-top: 4px;
  }
  .ugc-picker-{{ section.id }} .pk-atc:hover { opacity: 0.9; }
  .ugc-picker-{{ section.id }} .pk-atc:disabled { opacity: 0.4; cursor: not-allowed; }

  .ugc-toast-{{ section.id }} {
    position: fixed; bottom: 32px; left: 50%;
    transform: translateX(-50%) translateY(120px);
    background: var(--ugc-text); color: white;
    padding: 14px 28px; border-radius: 50px;
    font-size: 14px; font-weight: 600;
    display: flex; align-items: center; gap: 8px;
    z-index: 99999; transition: transform 0.4s var(--ugc-ease);
    box-shadow: 0 12px 40px rgba(0,0,0,0.2);
    pointer-events: none; white-space: nowrap;
  }
  .ugc-toast-{{ section.id }}.on { transform: translateX(-50%) translateY(0); pointer-events: auto; }
  .ugc-toast-{{ section.id }} svg { width: 18px; height: 18px; fill: var(--gri-teal); flex-shrink: 0; }

  @media (max-width: 768px) {
    .ugc-hdr-{{ section.id }} { margin-bottom: 32px; }
    .ugc-card-{{ section.id }} { flex: 0 0 75vw; max-width: 280px; }
    .ugc-scroll-{{ section.id }} { gap: 12px; padding: 4px 16px; scroll-padding: 16px; }
    .ugc-acts-{{ section.id }} { bottom: 105px; gap: 10px; }
    .ugc-abtn-{{ section.id }} svg { width: 22px; height: 22px; }
    .ugc-prod-{{ section.id }} { padding: 8px; gap: 8px; }
    .ugc-prod-{{ section.id }} img { width: 36px; height: 36px; }
    .ugc-pname-{{ section.id }} { font-size: 10px; }
    .ugc-pprice-{{ section.id }} .ugc-now { font-size: 12px; }
    .ugc-pprice-{{ section.id }} .ugc-was { font-size: 9px; }
    .ugc-atc-{{ section.id }} { width: 28px; height: 28px; }
    .ugc-atc-{{ section.id }} svg { width: 14px; height: 14px; }
    .ugc-play-{{ section.id }} { width: 44px; height: 44px; }
    .ugc-play-{{ section.id }} svg { width: 18px; height: 18px; }
  }

  /* ── Reels-style fullscreen modal (real Instagram UI) ── */
  .ugc-vid-{{ section.id }} { cursor: pointer; }
  .ugc-reels-{{ section.id }} {
    position: fixed; inset: 0;
    z-index: 999999;
    background: #000;
    display: none;
    align-items: center; justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
  }
  .ugc-reels-{{ section.id }}.on { display: flex; opacity: 1; }
  /* Stage = 9:16 phone aspect, locked to viewport height */
  .ugc-reels-stage-{{ section.id }} {
    position: relative;
    height: 100vh;
    height: 100dvh;
    aspect-ratio: 9 / 16;
    max-width: 100vw;
    background: #000;
    overflow: hidden;
    border-radius: 0;
  }
  @media (min-width: 769px) {
    .ugc-reels-stage-{{ section.id }} { border-radius: 12px; max-height: calc(100vh - 24px); }
  }
  /* Video fills the stage edge-to-edge (Instagram-style cover) */
  .ugc-reels-stage-{{ section.id }} video {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    background: #000;
    display: block;
  }
  /* Subtle gradients top + bottom so overlay text reads cleanly on any video */
  .ugc-reels-stage-{{ section.id }}::before,
  .ugc-reels-stage-{{ section.id }}::after {
    content: '';
    position: absolute; left: 0; right: 0;
    pointer-events: none;
    z-index: 2;
  }
  .ugc-reels-stage-{{ section.id }}::before {
    top: 0; height: 110px;
    background: linear-gradient(180deg, rgba(0,0,0,0.5) 0%, transparent 100%);
  }
  .ugc-reels-stage-{{ section.id }}::after {
    bottom: 0; height: 200px;
    background: linear-gradient(0deg, rgba(0,0,0,0.65) 0%, transparent 100%);
  }
  /* Close X — top-right INSIDE the stage */
  .ugc-reels-close-{{ section.id }} {
    position: absolute;
    top: 14px; right: 14px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: rgba(0,0,0,0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 0;
    color: #fff;
    cursor: pointer;
    z-index: 12;
    display: flex; align-items: center; justify-content: center;
    transition: background .2s ease, transform .2s ease;
  }
  .ugc-reels-close-{{ section.id }}:hover { background: rgba(0,0,0,0.6); transform: scale(1.05); }
  .ugc-reels-close-{{ section.id }} svg { width: 20px; height: 20px; fill: #fff; }
  /* Reels header — IG-style top label */
  .ugc-reels-top-{{ section.id }} {
    position: absolute;
    top: 18px; left: 18px;
    z-index: 11;
    color: #fff;
    font-size: 17px;
    font-weight: 700;
    text-shadow: 0 1px 4px rgba(0,0,0,0.4);
    letter-spacing: -0.01em;
    pointer-events: none;
  }
  /* Bottom caption stack — handle, product, shop */
  .ugc-reels-caption-{{ section.id }} {
    position: absolute;
    left: 14px; right: 84px; bottom: 18px;
    color: #fff;
    z-index: 11;
    pointer-events: auto;
    font-family: inherit;
  }
  .ugc-reels-caption-{{ section.id }} .handle {
    display: flex; align-items: center; gap: 6px;
    font-size: 14px; font-weight: 700;
    margin: 0 0 8px;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
  }
  .ugc-reels-caption-{{ section.id }} .handle .verified {
    width: 14px; height: 14px;
    background: #3897f0;
    border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .ugc-reels-caption-{{ section.id }} .handle .verified svg { width: 10px; height: 10px; fill: #fff; }
  .ugc-reels-caption-{{ section.id }} .pname {
    font-size: 13px; font-weight: 500; line-height: 1.35;
    margin: 0 0 6px;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
    max-width: 100%;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .ugc-reels-caption-{{ section.id }} .pprice {
    font-size: 13px; font-weight: 700;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
    margin: 0 0 10px;
  }
  .ugc-reels-caption-{{ section.id }} .pprice .was {
    text-decoration: line-through; opacity: 0.6; margin-left: 6px; font-weight: 400; font-size: 12px;
  }
  .ugc-reels-shop-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    padding: 9px 18px;
    background: #fff;
    color: #111;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.02em;
    pointer-events: auto;
    box-shadow: 0 4px 16px rgba(0,0,0,0.4);
    transition: transform 0.2s ease;
    z-index: 11;
  }
  .ugc-reels-shop-{{ section.id }}:hover { transform: translateY(-1px); }
