    var p = PRODUCTS[i];
    if (!p) return;
    slot.innerHTML =
      '<div class="ugc-prod-' + SID + '">' +
        '<a href="' + p.url + '" style="display:flex;align-items:center;gap:inherit;flex:1;min-width:0;text-decoration:none;color:inherit">' +
          '<img src="' + p.img + '" alt="' + p.t.replace(/"/g,'&quot;') + '" width="48" height="48" loading="lazy">' +
          '<div class="ugc-pinfo-' + SID + '">' +
            '<div class="ugc-pname-' + SID + '">' + p.t + '</div>' +
            '<div class="ugc-pprice-' + SID + '">' +
              '<span class="ugc-now">' + p.p + '</span>' +
              '<span class="ugc-was">' + p.cp + '</span>' +
            '</div>' +
          '</div>' +
        '</a>' +
      '</div>';
  });

  /* ── Init like/share counts ── */
  root.querySelectorAll('.js-ugc-like').forEach(function(btn) {
    var i = parseInt(btn.dataset.idx) || 0;
    var c = LIKES[i] || 25000;
    btn.dataset.likes = c;
    btn.querySelector('span').textContent = fmt(c);
  });
  root.querySelectorAll('.js-ugc-share').forEach(function(btn) {
    var i = parseInt(btn.dataset.idx) || 0;
    btn.querySelector('span').textContent = fmt(SHARES[i] || 1500);
  });

  /* ── Dots ── */
  var dotsEl = document.getElementById('ugc-dots-' + SID);
  var nd = Math.min(cards.length, 10);
  for (var d = 0; d < nd; d++) {
    var dot = document.createElement('div');
    dot.className = 'ugc-dot-' + SID + (d === 0 ? ' on' : '');
    dotsEl.appendChild(dot);
  }
  var dots = dotsEl.children;

  scroll.addEventListener('scroll', function() {
    var cw = cards[0].offsetWidth + 18;
    var idx = Math.round(scroll.scrollLeft / cw);
    var di = Math.min(Math.round(idx / (cards.length / nd)), nd - 1);
    for (var i = 0; i < dots.length; i++) dots[i].classList.toggle('on', i === di);
  });

  /* ── Nav (1 card at a time) ── */
  root.querySelector('.js-ugc-prev').addEventListener('click', function() { navScroll(-1); });
  root.querySelector('.js-ugc-next').addEventListener('click', function() { navScroll(1); });
  function navScroll(dir) {
    var gap = window.innerWidth <= 768 ? 12 : 18;
    var cw = cards[0].offsetWidth + gap;
    scroll.scrollBy({ left: cw * dir, behavior: 'smooth' });
  }

  /* ── Lazy-load video sources + autoplay on scroll ──
     - ZERO videos load on page load (preload="none", data-src)
     - Videos only load when within 200px of the carousel viewport
     - Only the visible video plays; others pause + free memory
     ── */
  function loadVideo(card) {
    var vid = card.querySelector('video');
    if (!vid || vid.dataset.loaded) return;
    var sources = vid.querySelectorAll('source[data-src]');
    if (sources.length) {
      sources.forEach(function(s) { s.src = s.dataset.src; s.removeAttribute('data-src'); });
      vid.load();
    }
    vid.dataset.loaded = '1';
  }

  if ('IntersectionObserver' in window) {
    /* Preload observer — loads video src when card is near viewport (200px buffer) */
    var preloadObs = new IntersectionObserver(function(entries) {
      entries.forEach(function(en) {
        if (en.isIntersecting) {
          loadVideo(en.target);
          preloadObs.unobserve(en.target);
        }
      });
    }, { rootMargin: '200px' });

    /* Play observer — plays/pauses based on visibility */
    var playObs = new IntersectionObserver(function(entries) {
      entries.forEach(function(en) {
        var vid = en.target.querySelector('video');
        var pb = en.target.querySelector('.ugc-play-' + SID);
        if (!vid) return;
        if (en.isIntersecting) {
          loadVideo(en.target);
          var p = vid.play();
          if (p) p.then(function() { if (pb) pb.classList.add('hide'); }).catch(function(){});
        } else {
          vid.pause();
          if (pb) pb.classList.remove('hide');
        }
      });
    }, { threshold: 0.3 });

    cards.forEach(function(c) { preloadObs.observe(c); playObs.observe(c); });
  }

  /* ── Volume toggle ── */
  root.querySelectorAll('.js-ugc-vol').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault(); e.stopPropagation();
      var card = this.closest('.ugc-card-' + SID);
      var vid = card ? card.querySelector('video') : null;
      if (!vid) return;
      vid.muted = !vid.muted;
      this.classList.toggle('is-unmuted', !vid.muted);
    });
  });

  /* ── Like ── */
  root.querySelectorAll('.js-ugc-like').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault(); e.stopPropagation();
      var liked = this.classList.toggle('is-liked');
      var base = parseInt(this.dataset.likes) || 25000;
      this.querySelector('span').textContent = fmt(liked ? base + 1 : base);
    });
  });

  /* ── Share (paper airplane icon — copies link, shows "Copied") ── */
  root.querySelectorAll('.js-ugc-share').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault(); e.stopPropagation();
      var self = this;
      var i = parseInt(self.dataset.idx) || 0;
      var p = PRODUCTS[i];
      var shareUrl = window.location.origin + (p ? p.url : '/') + '?utm_source=ugc_share';
      var label = self.querySelector('span');
      var origText = label.textContent;

      function onCopied() {
        label.textContent = 'Copied';
        setTimeout(function() { label.textContent = origText; }, 2000);
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(shareUrl).then(onCopied).catch(function() { fallbackCopy(shareUrl, onCopied); });
      } else {
        fallbackCopy(shareUrl, onCopied);
      }
    });
  });

  function fallbackCopy(text, cb) {
    var ta = document.createElement('textarea');
    ta.value = text; ta.style.position = 'fixed'; ta.style.left = '-9999px';
    document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); if (cb) cb(); } catch(e) {}
    document.body.removeChild(ta);
  }


  /* ── Fly-to-cart animation ── */
  function flyToCart(imgSrc) {
    var cartIcon = document.getElementById('cart-icon-bubble');
    if (!cartIcon || !imgSrc) return;
    var cartRect = cartIcon.getBoundingClientRect();
    var fly = document.createElement('img');
    fly.src = imgSrc;
    fly.style.cssText = 'position:fixed;width:48px;height:48px;border-radius:12px;object-fit:contain;background:#f5f5f5;z-index:999999;pointer-events:none;transition:all 0.6s cubic-bezier(0.16,1,0.3,1);box-shadow:0 4px 16px rgba(0,0,0,0.2)';
    fly.style.left = (window.innerWidth / 2 - 24) + 'px';
    fly.style.top = (window.innerHeight / 2) + 'px';
    document.body.appendChild(fly);
    requestAnimationFrame(function() {
      fly.style.left = cartRect.left + 'px';
      fly.style.top = cartRect.top + 'px';
      fly.style.width = '16px';
      fly.style.height = '16px';
      fly.style.opacity = '0.3';
    });
    setTimeout(function() { fly.remove(); }, 700);
  }

  /* ── Colour picker popup ── */
  var pkOverlay = document.getElementById('ugc-pk-overlay-' + SID);
  var pkPanel = document.getElementById('ugc-pk-' + SID);
  var pkImg = document.getElementById('ugc-pk-img-' + SID);
  var pkName = document.getElementById('ugc-pk-name-' + SID);
  var pkPrice = document.getElementById('ugc-pk-price-' + SID);
  var pkOpts = document.getElementById('ugc-pk-opts-' + SID);
  var pkAtc = document.getElementById('ugc-pk-atc-' + SID);
  var pkClose = document.getElementById('ugc-pk-close-' + SID);
  var pickerState = { variants: [], selectedId: null, btn: null, img: '' };

  function openPicker(prodData, cardBtn, img, name, price) {
    pkImg.src = img || '';
    pkName.textContent = name;
    pkPrice.textContent = price;
    pkOpts.innerHTML = '';
    pickerState.selectedId = null;
    pickerState.btn = cardBtn;
    pickerState.img = img;

    /* Find available variants */
    var available = prodData.variants.filter(function(v) { return v.available; });
    var allVariants = prodData.variants;

    /* Single variant or single option value — skip picker, add directly */
    if (allVariants.length <= 1) {
      var vid = available.length ? available[0].id : allVariants[0].id;
      addToCartDirect(vid, name, cardBtn, img);
      return;
    }

    /* Build option buttons — use variant title (e.g. "Blue", "Pink", "Secret") */
    allVariants.forEach(function(v) {
      var optBtn = document.createElement('button');
      optBtn.className = 'pk-opt';
      optBtn.textContent = v.title;
      optBtn.dataset.variantId = String(v.id);
      if (!v.available) {
        optBtn.style.opacity = '0.35';
        optBtn.style.textDecoration = 'line-through';
        optBtn.style.pointerEvents = 'none';
      }
      optBtn.addEventListener('click', function() {
        pkOpts.querySelectorAll('.pk-opt').forEach(function(b) { b.classList.remove('on'); });
        this.classList.add('on');
        pickerState.selectedId = Number(this.dataset.variantId);
        pkAtc.disabled = false;
      });
      pkOpts.appendChild(optBtn);
    });

    /* Auto-select if only 1 available */
    if (available.length === 1) {
      var autoBtn = pkOpts.querySelector('[data-variant-id="' + available[0].id + '"]');
      if (autoBtn) { autoBtn.click(); }
    }

    pkAtc.disabled = (available.length !== 1);
    pkAtc.textContent = 'Add to Cart';
    pkOverlay.classList.add('on');
    setTimeout(function() { pkPanel.classList.add('on'); }, 10);
  }

  function closePicker() {
    pkPanel.classList.remove('on');
    setTimeout(function() { pkOverlay.classList.remove('on'); }, 300);
  }

  pkOverlay.addEventListener('click', closePicker);
  pkClose.addEventListener('click', function(e) { e.preventDefault(); e.stopPropagation(); closePicker(); });

  function addToCartDirect(variantId, name, cardBtn, prodImg) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] })
    })
    .then(function(r) {
      if (!r.ok) throw new Error('Cart add failed: ' + r.status);
      return r.json();
    })
    .then(function() {
      closePicker();
      flyToCart(prodImg);
      if (cardBtn) {
        cardBtn.classList.add('is-added');
        setTimeout(function() { cardBtn.classList.remove('is-added'); }, 3000);
      }
      showToast('Added to Cart');
    })
    .catch(function(err) {
      closePicker();
      showToast('Could not add — try again');
    });
  }

  /* Picker ATC button */
  pkAtc.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    if (!pickerState.selectedId) return;
    this.textContent = 'Adding...';
    this.disabled = true;
    addToCartDirect(pickerState.selectedId, pkName.textContent, pickerState.btn, pickerState.img);
  });

  /* ── Add to cart — bind directly on each button (delegated handler misses mobile taps) ── */
  /* ── ATC handler — called via inline onclick, zero duplicate risk ── */
  window['ugcAtc_' + SID] = function(btn) {
    if (btn.classList.contains('is-added') || btn.dataset.busy) return;
    btn.dataset.busy = '1';

    var handle = btn.dataset.handle;
    var name = btn.dataset.name;
    var card = btn.closest('.ugc-card-' + SID);
    var idx = card ? parseInt(card.dataset.idx) : -1;
    var p = (idx >= 0 && idx < PRODUCTS.length) ? PRODUCTS[idx] : null;

    if (handle === 'tnt-gender-reveal-australia') {
      window.location.href = '/products/tnt-gender-reveal-australia';
      return;
    }

    fetch('/products/' + handle + '.js')
      .then(function(r) { if (!r.ok) throw new Error('fail'); return r.json(); })
      .then(function(prod) {
        btn.dataset.busy = '';
        openPicker(prod, btn, p ? p.img : '', name || prod.title, p ? p.p : ('$' + (prod.price / 100).toFixed(2)));
      })
      .catch(function() { btn.dataset.busy = ''; showToast('Could not load product'); });
  };

  /* ── Toast ── */
  var tTimer;
  function showToast(msg) {
    clearTimeout(tTimer);
    tmsg.textContent = msg;
    toast.classList.add('on');
    tTimer = setTimeout(function() { toast.classList.remove('on'); }, 2500);
  }

  /* Native scroll-snap handles 1-card-at-a-time swiping on mobile */

  /* ── Reels-style fullscreen modal ── */
  var reelsModal = document.getElementById('ugc-reels-' + SID);
  var reelsClose = document.getElementById('ugc-reels-close-' + SID);
  var reelsVid = document.getElementById('ugc-reels-vid-' + SID);
  var reelsCap = document.getElementById('ugc-reels-cap-' + SID);
  var reelsShop = document.getElementById('ugc-reels-shop-' + SID);
  var reelsLikeBtn = document.getElementById('ugc-reels-like-' + SID);
  var reelsShareBtn = document.getElementById('ugc-reels-share-' + SID);
  var reelsState = { active: false, sourceCard: null, currentIdx: -1, savedScrollY: 0 };

  function openReel(card) {
    if (!card || !reelsModal || !reelsVid) return;
    var srcVid = card.querySelector('video');
    if (!srcVid) return;

    /* Make sure the card video has loaded its sources first */
    loadVideo(card);

    /* Clone source URLs into modal video element */
    reelsVid.innerHTML = '';
    var sources = srcVid.querySelectorAll('source');
    sources.forEach(function(s) {
      var ns = document.createElement('source');
      var url = s.getAttribute('src') || s.getAttribute('data-src');
      if (url) ns.src = url;
      if (s.type) ns.type = s.type;
      reelsVid.appendChild(ns);
    });
    reelsVid.load();
    reelsVid.muted = false;
    reelsVid.volume = 1.0;
    reelsVid.currentTime = 0;

    /* Populate caption + shop link from product data */
    var idx = parseInt(card.dataset.idx) || 0;
    reelsState.currentIdx = idx;
    var prod = PRODUCTS[idx];
    if (prod) {
      reelsCap.querySelector('.pname').textContent = prod.t;
      var priceHtml = '<span class="now">' + prod.p + '</span>';
      if (prod.cp) priceHtml += '<span class="was">' + prod.cp + '</span>';
      reelsCap.querySelector('.pprice').innerHTML = priceHtml;
      reelsShop.href = prod.url || '#';
      reelsShop.style.display = 'inline-block';
    } else {
      reelsCap.querySelector('.pname').textContent = '';
      reelsCap.querySelector('.pprice').innerHTML = '';
      reelsShop.style.display = 'none';
    }

    /* Sync like + share counts from source card state */
    if (reelsLikeBtn) {
      var srcLikeBtn = card.querySelector('.js-ugc-like');
      var liked = srcLikeBtn ? srcLikeBtn.classList.contains('is-liked') : false;
      var likeBase = parseInt(srcLikeBtn ? srcLikeBtn.dataset.likes : LIKES[idx]) || (LIKES[idx] || 25000);
      reelsLikeBtn.classList.toggle('is-liked', liked);
      reelsLikeBtn.querySelector('.cnt').textContent = fmt(liked ? likeBase + 1 : likeBase);
    }
    if (reelsShareBtn) {
      reelsShareBtn.querySelector('.cnt').textContent = fmt(SHARES[idx] || 1500);
    }

    /* Pause card video so audio doesn't double up */
    try { srcVid.pause(); } catch(e) {}
    reelsState.active = true;
    reelsState.sourceCard = card;

    /* Capture current scroll position so we can restore it on close */
    reelsState.savedScrollY = window.scrollY || window.pageYOffset || 0;
    document.body.style.top = '-' + reelsState.savedScrollY + 'px';
    document.body.classList.add('ugc-reels-open-' + SID);
    reelsModal.classList.add('on');

    /* Try to play with sound. iOS may reject if no user gesture, but the tap counts. */
    var p = reelsVid.play();
    if (p && p.catch) {
      p.catch(function() {
        /* Fall back to muted autoplay if sound is blocked, user can unmute via controls */
        reelsVid.muted = true;
        reelsVid.play().catch(function(){});
      });
    }
  }

  function closeReel() {
    if (!reelsModal) return;
    reelsModal.classList.remove('on');

    /* Release scroll lock + restore page to the exact position we were at */
    document.body.classList.remove('ugc-reels-open-' + SID);
    document.body.style.top = '';
    var restoreY = reelsState.savedScrollY || 0;
    /* Disable smooth scroll for this restoration so we don't visually flash */
    var prevBehavior = document.documentElement.style.scrollBehavior;
    document.documentElement.style.scrollBehavior = 'auto';
    window.scrollTo(0, restoreY);
    document.documentElement.style.scrollBehavior = prevBehavior || '';

    try {
      reelsVid.pause();
      reelsVid.removeAttribute('src');
      reelsVid.innerHTML = '';
      reelsVid.load();
    } catch(e) {}
    /* Resume card video (muted autoplay will kick back in via IntersectionObserver) */
    if (reelsState.sourceCard) {
      var cv = reelsState.sourceCard.querySelector('video');
      if (cv) {
        cv.muted = true;
        cv.play().catch(function(){});
      }
    }
    reelsState.active = false;
    reelsState.sourceCard = null;
    reelsState.savedScrollY = 0;
  }

  /* Bind click handlers on each video tile (excluding inner buttons) */
  cards.forEach(function(card) {
    var vidWrap = card.querySelector('.ugc-vid-' + SID);
    if (!vidWrap) return;
    vidWrap.addEventListener('click', function(e) {
      /* Bail out if user tapped an interactive control inside the tile */
      var t = e.target;
      while (t && t !== vidWrap) {
        if (t.tagName === 'BUTTON' || t.tagName === 'A' ||
            (t.classList && (t.classList.contains('js-ugc-vol') || t.classList.contains('js-ugc-like') || t.classList.contains('js-ugc-share')))) {
          return;
        }
        t = t.parentNode;
      }
      openReel(card);
    });
  });

  /* Close handlers */
  if (reelsClose) reelsClose.addEventListener('click', closeReel);
  if (reelsModal) {
    reelsModal.addEventListener('click', function(e) {
      /* Close on backdrop click (outside the stage) */
      if (e.target === reelsModal) closeReel();
    });
  }
  document.addEventListener('keydown', function(e) {
    if (reelsState.active && (e.key === 'Escape' || e.keyCode === 27)) closeReel();
  });

  /* Modal like — toggle + sync count back to source card */
  if (reelsLikeBtn) {
    reelsLikeBtn.addEventListener('click', function(e) {
      e.preventDefault(); e.stopPropagation();
      var idx = reelsState.currentIdx;
      var card = reelsState.sourceCard;
      var srcBtn = card ? card.querySelector('.js-ugc-like') : null;
      var liked = this.classList.toggle('is-liked');
      var base = parseInt(srcBtn ? srcBtn.dataset.likes : LIKES[idx]) || (LIKES[idx] || 25000);
      this.querySelector('.cnt').textContent = fmt(liked ? base + 1 : base);
      /* Mirror onto the source card so it persists when modal closes */
      if (srcBtn) {
        srcBtn.classList.toggle('is-liked', liked);
        srcBtn.querySelector('span').textContent = fmt(liked ? base + 1 : base);
      }
    });
  }

  /* Modal share — copy product URL + show "Copied" feedback */
  if (reelsShareBtn) {
    reelsShareBtn.addEventListener('click', function(e) {
      e.preventDefault(); e.stopPropagation();
      var self = this;
      var idx = reelsState.currentIdx;
      var p = PRODUCTS[idx];
      var shareUrl = window.location.origin + (p ? p.url : '/') + '?utm_source=ugc_reels_share';
      var label = self.querySelector('.cnt');
      var origText = label.textContent;
      function onCopied() {
        label.textContent = 'Copied';
        setTimeout(function() { label.textContent = origText; }, 2000);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(shareUrl).then(onCopied).catch(function() { fallbackCopy(shareUrl, onCopied); });
      } else {
        fallbackCopy(shareUrl, onCopied);
      }
    });
  }

})();
</script>

<script>
/* Force shipping protection ALWAYS ON — lock the property so nothing can override it */
(function(){
  function lockShippingProtection() {
    if (!window.simplyInsurance) return;
    var plan = window.simplyInsurance.insurancePlan;
    if (!plan) return;
    /* Lock auto_enable to true permanently */
    try {
      Object.defineProperty(plan, 'insurance_auto_enable', {
        get: function() { return true; },
        set: function() { /* ignore any attempt to set false */ },
        configurable: false
      });
    } catch(e) {
      plan.insurance_auto_enable = true;
    }
    /* Also prevent toggleUncheck from unchecking */
    if (window.simplyInsurance.toggleUncheck) {
      window.simplyInsurance.toggleUncheck = function() {};
    }
  }
  /* Run immediately if available */
  lockShippingProtection();
  /* Also run after DOM ready (app may not have loaded yet) */
  document.addEventListener('DOMContentLoaded', function() {
    lockShippingProtection();
    /* Final check after app fully initialises */
    setTimeout(lockShippingProtection, 1000);
    setTimeout(lockShippingProtection, 3000);
  });
})();
</script>

